# Kopieer dit bestand naar .env.local en vul je eigen SMTP-gegevens in.
# .env.local wordt nooit naar GitHub gepusht (staat in .gitignore).
# Zet dezelfde variabelen ook in je Vercel-projectinstellingen (Settings > Environment Variables)
# voordat je opnieuw deployt, anders werkt het contactformulier niet in productie.

# SMTP-server van je hostingpartij, te vinden bij de e-mailinstellingen van je hostingaccount
# (bij "Uitgaande mail" / "SMTP", niet bij "Inkomende mail" / IMAP-POP3).
SMTP_HOST=mail.theory7.net
# Meestal 587 (met SMTP_SECURE=false) of 465 (met SMTP_SECURE=true).
SMTP_PORT=465
SMTP_SECURE=true

# Je volledige e-mailadres en het bijbehorende wachtwoord.
SMTP_USER=contact@rekenstation.nl
SMTP_PASSWORD=

# E-mailadres waar contactformulier-berichten naartoe gestuurd worden.
# Laat leeg om SMTP_USER te gebruiken.
CONTACT_TO_EMAIL=contact@rekenstation.nl
